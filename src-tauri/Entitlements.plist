<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Deliberately empty. Hardened Runtime is on (tauri.conf.json), and:
    - NO com.apple.security.app-sandbox: the sandbox blocks the Accessibility API and
      global hotkeys this app depends on, so it ships as a notarized .dmg instead of via
      the Mac App Store (guide §67).
    - NO com.apple.security.cs.allow-jit: WKWebView runs JavaScript in its own process.
    - NO apple-events: the clipboard fallback posts a keystroke via CGEvent, not AppleScript.
  -->
</dict>
</plist>
