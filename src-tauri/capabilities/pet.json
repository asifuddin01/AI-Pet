{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "pet-window",
  "description": "The floating pet: window control, selected-text flow, AI streaming and speech. No key management.",
  "windows": ["pet"],
  "permissions": [
    "core:event:default",
    "core:menu:default",
    "allow-get-settings",
    "allow-save-settings",
    "allow-get-app-status",
    "allow-get-screens",
    "allow-get-mouse-position",
    "allow-get-pet-frame",
    "allow-set-pet-frame",
    "allow-set-pet-position",
    "allow-move-pet-to",
    "allow-stop-pet-motion",
    "allow-show-pet",
    "allow-hide-pet",
    "allow-focus-pet",
    "allow-release-focus",
    "allow-set-click-through",
    "allow-check-accessibility-permission",
    "allow-request-accessibility-permission",
    "allow-open-accessibility-settings",
    "allow-read-clipboard",
    "allow-write-clipboard",
    "allow-ai-stream",
    "allow-ai-cancel",
    "allow-list-characters",
    "allow-read-character-file",
    "allow-tts-speak",
    "allow-tts-stop",
    "allow-get-notes",
    "allow-save-notes",
    "allow-voice-start",
    "allow-voice-stop",
    "allow-voice-cancel",
    "allow-get-idle-seconds",
    "allow-check-for-update",
    "allow-web-search",
    "allow-open-search-result",
    "allow-open-release-page",
    "allow-open-settings-window",
    "allow-quit-app",
    "allow-app-log"
  ]
}
