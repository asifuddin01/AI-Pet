# Development-only provider override (optional).
# In normal use, configure the provider in Settings; the API key is stored in the macOS Keychain.
# Copy to `.env`, fill in, and export before `npm run tauri dev`:
#   set -a; source .env; set +a; npm run tauri dev
# Never commit a real key.

# openai (any OpenAI-compatible endpoint) | anthropic
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
