{
  "name": "ai-pet",
  "private": true,
  "version": "1.0.0",
  "description": "A tiny, lightweight AI desktop pet for macOS (Tauri 2 + Rust + TypeScript).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build --target universal-apple-darwin"
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.5.5",
    "@tauri-apps/api": "^2.12.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "@types/three": "^0.186.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
